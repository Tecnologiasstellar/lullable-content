# Lullable content system — what should never enter version control.
#
# This folder sits alongside the app inside the LULLABLE directory. If any
# ancestor is a git repository, these rules keep the content pipeline from
# bloating it.

# Audio. This is the important one.
# A 45-minute WAV master is ~240 MB. Four episodes is ~1 GB, twenty is ~4.8 GB.
# Masters belong in cloud storage, not in a repo. Delivery files are generated
# from the master and uploaded to Supabase, so they do not belong here either.
Stories/*/audio/
*.wav
*.m4a
*.mp3
*.aac

# Derived artifacts. Every one of these is regenerated by:  lullable.py build
# The manifest is the source of truth; committing the outputs invites drift.
Stories/*/_generated/

# The tracker is a generated report, rebuilt by:  lullable.py tracker
# Uncomment if you would rather not carry a binary that changes on every run.
# Lullable_Story_Card_Tracker.xlsx

# Housekeeping
__pycache__/
*.pyc
.DS_Store
*.tmp
~$*

# local interpreter for Tools/lullable.py — see Docs/06-decisions.md D22
.venv/

# Supabase CLI local link state — supabase/.temp/pooler-url holds a live DB
# connection string with credentials. Never commit this.
supabase/.temp/

# AWS credentials for the Polly renderer. These are real keys — the tools
# beside them are worth versioning, the keys never are.
AWS_Polly/*.csv
AWS_Polly/*.rtf

# Superseded ElevenLabs-era masters (~1.1 GB) staged for deletion. The audio
# rules above miss the split .chunk_* files, so name the folder explicitly.
Stories/_to_delete/
